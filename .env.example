# Isocline self-hosted configuration.   cp .env.example .env && docker compose up --build
# This file works unchanged for a local installation. Never commit your .env.

# --- Secrets -------------------------------------------------------------------------------------------------------
# Leave empty to have random values generated on first start and stored in the `secrets` Docker volume.
# Set them here to manage them yourself (required when you run the API outside Docker Compose):
#   ISOCLINE_SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   ISOCLINE_ENCRYPTION_KEY: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ISOCLINE_SECRET_KEY=
ISOCLINE_ENCRYPTION_KEY=
SANDBOX_TOKEN=
# The database is only reachable inside the Compose network. Change it if you publish the port.
POSTGRES_PASSWORD=isocline

# --- Installation --------------------------------------------------------------------------------------------------
ISOCLINE_ENV=development              # "production" refuses to start without explicit secrets
ISOCLINE_PUBLIC_BASE_URL=http://localhost:3000
ISOCLINE_COOKIE_SECURE=false          # true behind HTTPS
# The first account to register becomes the administrator. After that, sign-up is closed unless:
ISOCLINE_ALLOW_SIGNUP=false
# Optional headless setup: create the admin account on first start (password: at least 10 characters).
ISOCLINE_BOOTSTRAP_ADMIN_EMAIL=
ISOCLINE_BOOTSTRAP_ADMIN_PASSWORD=

# --- Model providers (bring your own key) --------------------------------------------------------------------------
# Keys set here are available to every account on this installation. Keys added in the UI (Keys & secrets) are
# encrypted per workspace and take precedence.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Ollama on the Docker host (Linux, macOS and Windows). Use http://ollama:11434 for an Ollama container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Any OpenAI-compatible server (vLLM, LM Studio, llama.cpp server, LiteLLM, ...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Deterministic local test provider: lets you run workflows with no API key. It is NOT a language model.
ISOCLINE_ENABLE_TEST_PROVIDER=true

# --- Web search tool: searxng (docker compose --profile search up) | tavily | brave --------------------------------
ISOCLINE_SEARCH_PROVIDER=searxng
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Knowledge bases: hashing (built-in lexical, no API) | ollama | openai_compatible ------------------------------
ISOCLINE_EMBEDDING_PROVIDER=hashing
ISOCLINE_EMBEDDING_BASE_URL=https://api.openai.com/v1
ISOCLINE_EMBEDDING_API_KEY=
ISOCLINE_EMBEDDING_MODEL=text-embedding-3-small

# --- Email (password reset). Without SMTP, links are written to the API log. --------------------------------------
ISOCLINE_SMTP_HOST=
ISOCLINE_SMTP_USER=
ISOCLINE_SMTP_PASSWORD=

# --- Observability: OpenTelemetry traces are exported only when an endpoint is set. Nothing is sent anywhere else. --
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Sandbox hardening ---------------------------------------------------------------------------------------------
SANDBOX_RUNTIME=                       # "runsc" to use gVisor if it is installed on the host
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
WORKER_CONCURRENCY=4
